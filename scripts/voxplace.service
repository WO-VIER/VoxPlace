[Unit]
Description=VoxPlace Game Server
After=network.target

[Service]
Type=simple
Environment=VOXPLACE_PROFILE_WORKERS=1
Environment=VOXPLACE_ADMIN_USERS=Admin
Environment=VOXPLACE_SERVER_KEY_PATH=/root/VoxPlace/voxplace_server_identity.key
Environment=VOXPLACE_SERVER_PROOF_PATH=/var/www/voxplace/.proof/voxplace-server.json
Environment=VOXPLACE_SERVER_PROOF_HOST=play.voxplace.codes
ExecStart=/root/VoxPlace/build/VoxPlaceServer --port 28713
WorkingDirectory=/root/VoxPlace
Nice=-20
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
